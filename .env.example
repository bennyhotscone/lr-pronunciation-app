# Copy to .env.local (never commit real secrets)

# Postgres (Vercel Postgres / Neon / Prisma Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-hex-32"
AUTH_TRUST_HOST=true

# Existing Mandarin Studio (unchanged)
BLOB_READ_WRITE_TOKEN=""
MANDARIN_STUDIO_PASSWORD=""

# Portal files + Lesson Capture frames use the same Blob store
# (prefixes portal-files/ and lesson-capture/frames — never studio-audio/)

# --- Lesson Capture AI ---
# Pipeline: auto screenshots (~60s) → tesseract.js OCR → callLlm (Groq) for summary/memory.
# Free Groq key: https://console.groq.com  (ChatGPT Plus is NOT an API key)
GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile
#
# Optional text fallbacks (not required if GROQ_API_KEY is set):
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
