# Copy to .env.local (never commit real secrets)

# Postgres (Vercel Postgres / Neon / Prisma Postgres)
DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DB?sslmode=require"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-hex-32"
AUTH_TRUST_HOST=true

# Existing Mandarin Studio (unchanged)
BLOB_READ_WRITE_TOKEN=""
MANDARIN_STUDIO_PASSWORD=""

# Portal files use the same Blob store under prefix portal-files/ (never studio-audio/)
