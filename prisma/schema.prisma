generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum MembershipStatus {
  ACTIVE
  LEFT
  ARCHIVED
}

enum HomeworkStatus {
  ASSIGNED
  SUBMITTED
  REVIEWED
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  PAUSED
}

enum DiaryVisibility {
  SHARED
  PRIVATE
}

enum RecommendationApproval {
  DRAFT
  APPROVED
  REJECTED
}

enum RecommendationType {
  LINK
  TOOL
  ACTIVITY
}

enum PdfSubmissionStatus {
  SUBMITTED
  REVIEWED
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         Role
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  profile              StudentProfile?
  taughtClasses        Class[]              @relation("ClassTeacher")
  memberships          ClassMembership[]
  uploadedResources    Resource[]           @relation("ResourceUploader")
  createdLessons       Lesson[]             @relation("LessonCreator")
  createdHomework      Homework[]           @relation("HomeworkCreator")
  studentHomework      Homework[]           @relation("HomeworkStudent")
  individualLessons    Lesson[]             @relation("LessonStudent")
  individualResources  Resource[]           @relation("ResourceStudent")
  goals                Goal[]
  diaryEntries         DiaryEntry[]
  teacherNotesAuthored TeacherNote[]        @relation("NoteAuthor")
  teacherNotesAbout    TeacherNote[]        @relation("NoteStudent")
  recommendations      Recommendation[]     @relation("RecommendationStudent")
  progressEvents       LearningProgress[]
  classPostsAuthored   ClassPost[]          @relation("ClassPostAuthor")
  classPostComments    ClassPostComment[]   @relation("ClassPostCommentAuthor")
  passwordResetTokens  PasswordResetToken[]
  classDiaryAuthored   ClassLesson[]        @relation("ClassLessonAuthor")
  vocabEntries         VocabEntry[]
  pdfWriteDrafts       PdfWriteDraft[]
  pdfSubmissions       PdfSubmission[]      @relation("PdfSubmissionStudent")
  pdfSubmissionsReviewed PdfSubmission[]    @relation("PdfSubmissionReviewer")
  storyAssignmentsCreated StoryAssignment[] @relation("StoryAssignmentCreator")
  storyAttempts           StoryAttempt[]    @relation("StoryAttemptStudent")
  storyFeedbackAuthored   StoryTeacherFeedback[] @relation("StoryFeedbackAuthor")
  resourceFolders         ResourceFolder[]  @relation("ResourceFolderOwner")
  resourceStars           ResourceStar[]
  classWallet             ClassWallet?
  moneyAwardsAuthored     MoneyLedger[]     @relation("MoneyAwardAuthor")
  vocabPracticePacks      VocabPracticePack[]
  lessonCaptureSessionsAsTeacher LessonCaptureSession[] @relation("LessonCaptureTeacher")
  lessonCaptureSessionsAsStudent LessonCaptureSession[] @relation("LessonCaptureStudent")
  japaneseBlockProgress        JapaneseBlockProgress[]
  japaneseWordOverrides        JapaneseWordOverride[]
  japaneseWordStats              JapaneseWordStat[]
  japaneseMilestoneStories       JapaneseMilestoneStory[]
  japaneseMilestoneProgress      JapaneseMilestoneProgress[]
  grammarBlockProgress         GrammarBlockProgress[]
}

model StudentProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  fullName           String?
  preferredName      String?
  avatarId           String   @default("fox")
  englishLevel       String?
  firstLanguage      String?
  /// BCP-47-ish target language for PDF tap-translate (e.g. zh-CN, ja, th).
  targetLang         String   @default("zh-CN")
  /// Desk surface theme: slate | warm | classic
  deskTheme          String   @default("slate")
  courseType         String?
  learningObjectives String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Class {
  id          String    @id @default(cuid())
  name        String
  description String?
  level       String?
  /// Short shareable join code (e.g. K7M2PQ). Unique across classrooms.
  inviteCode  String    @unique
  teacherId   String
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  teacher         User               @relation("ClassTeacher", fields: [teacherId], references: [id])
  memberships     ClassMembership[]
  lessons         Lesson[]
  resources       Resource[]
  homework        Homework[]
  recommendations Recommendation[]
  posts           ClassPost[]
  classLessons    ClassLesson[]
  classTags       ClassTag[]
  storyAssignments StoryAssignment[]

  @@index([teacherId, archivedAt])
}

/// Live membership policy: ACTIVE membership grants current class library access.
/// Leaving (LEFT/ARCHIVED) removes class-scoped access immediately.
/// Individual (studentId) assignments persist regardless of class membership.
model ClassMembership {
  id        String           @id @default(cuid())
  classId   String
  studentId String
  status    MembershipStatus @default(ACTIVE)
  joinedAt  DateTime         @default(now())
  leftAt    DateTime?

  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@index([studentId, status])
}

model Lesson {
  id           String   @id @default(cuid())
  title        String
  date         DateTime @default(now())
  summary      String?
  teacherNotes String?
  tags         String[] @default([])
  topics       String[] @default([])
  classId      String?
  studentId    String?
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  class           Class?            @relation(fields: [classId], references: [id], onDelete: Cascade)
  student         User?             @relation("LessonStudent", fields: [studentId], references: [id], onDelete: Cascade)
  createdBy       User              @relation("LessonCreator", fields: [createdById], references: [id])
  resources       Resource[]
  homework        Homework[]
  recommendations Recommendation[]

  @@index([classId, date])
  @@index([studentId, date])
}

model Resource {
  id          String   @id @default(cuid())
  title       String
  filename    String
  blobPath    String
  blobUrl     String
  mimeType    String
  category    String?
  /// Classroom material basket: INFO (explanation) | EXERCISE (activities).
  materialKind String  @default("INFO")
  description String?
  sizeBytes   Int?
  tags        String[] @default([])
  lessonId    String?
  classId     String?
  studentId   String?
  folderId    String?
  uploadedById String
  createdAt   DateTime @default(now())

  lesson     Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  class      Class?  @relation(fields: [classId], references: [id], onDelete: Cascade)
  student    User?   @relation("ResourceStudent", fields: [studentId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation("ResourceUploader", fields: [uploadedById], references: [id])
  folder     ResourceFolder? @relation(fields: [folderId], references: [id], onDelete: SetNull)
  stars      ResourceStar[]

  @@index([classId, createdAt])
  @@index([studentId, createdAt])
  @@index([lessonId])
  @@index([folderId])
}

/// Student-owned Drive-style folders for organizing class/individual files.
model ResourceFolder {
  id        String   @id @default(cuid())
  name      String
  ownerId   String
  classId   String?
  parentId  String?
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  owner    User            @relation("ResourceFolderOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  parent   ResourceFolder? @relation("FolderTree", fields: [parentId], references: [id], onDelete: Cascade)
  children ResourceFolder[] @relation("FolderTree")
  resources Resource[]

  @@index([ownerId, parentId])
  @@index([classId])
}

/// Per-student starred files (Drive-style favorites).
model ResourceStar {
  id         String   @id @default(cuid())
  studentId  String
  resourceId String
  createdAt  DateTime @default(now())

  student  User     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  resource Resource @relation(fields: [resourceId], references: [id], onDelete: Cascade)

  @@unique([studentId, resourceId])
  @@index([studentId, createdAt])
}

model Homework {
  id           String         @id @default(cuid())
  title        String
  instructions String
  dueAt        DateTime?
  status       HomeworkStatus @default(ASSIGNED)
  lessonId     String?
  classId      String?
  studentId    String?
  createdById  String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  lesson    Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  class     Class?  @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   User?   @relation("HomeworkStudent", fields: [studentId], references: [id], onDelete: Cascade)
  createdBy User    @relation("HomeworkCreator", fields: [createdById], references: [id])
  storyAssignment StoryAssignment?

  @@index([classId, dueAt])
  @@index([studentId, dueAt])
}

model Goal {
  id            String     @id @default(cuid())
  studentId     String
  title         String
  description   String?
  targetDate    DateTime?
  status        GoalStatus @default(ACTIVE)
  progressPct   Int        @default(0)
  teacherNotes  String?
  studentNotes  String?
  /// TEACHER = accountability (teacher ticks). STUDENT_HELP = self-study from â€œneed more helpâ€ (student ticks).
  source        String     @default("TEACHER")
  /// Optional topic tag that created a STUDENT_HELP goal.
  topicTag      String?
  /// Learning pyramid: 1 = base (general), 2 = mid, 3 = tip (specialized).
  pyramidTier   Int        @default(2)
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  student         User                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  checklistItems  GoalChecklistItem[]

  @@index([studentId, status])
  @@index([studentId, source, topicTag])
  @@index([studentId, pyramidTier])
}

/// Checklist steps on a student goal. Only teachers/admins can mark items done (accountability).
model GoalChecklistItem {
  id        String    @id @default(cuid())
  goalId    String
  title     String
  sortOrder Int       @default(0)
  done      Boolean   @default(false)
  doneAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, sortOrder])
}

model DiaryEntry {
  id         String          @id @default(cuid())
  studentId  String
  date       DateTime        @default(now())
  title      String?
  body       String
  confidence Int?
  tag        String?
  visibility DiaryVisibility @default(SHARED)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, date])
}

model TeacherNote {
  id               String   @id @default(cuid())
  studentId        String
  body             String
  visibleToStudent Boolean  @default(false)
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  student   User @relation("NoteStudent", fields: [studentId], references: [id], onDelete: Cascade)
  createdBy User @relation("NoteAuthor", fields: [createdById], references: [id])

  @@index([studentId])
}

model Recommendation {
  id          String                 @id @default(cuid())
  title       String
  url         String?
  description String?
  type        RecommendationType     @default(LINK)
  topic       String?
  difficulty  String?
  approval    RecommendationApproval @default(DRAFT)
  classId     String?
  studentId   String?
  lessonId    String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  class   Class?  @relation(fields: [classId], references: [id], onDelete: Cascade)
  student User?   @relation("RecommendationStudent", fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([classId, approval])
  @@index([studentId, approval])
}

/// Portal learning progress persisted in DB (not localStorage).
model LearningProgress {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  refId     String?
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, refId])
  @@index([userId, kind])
}

/// Classroom bulletin: teachers/admins post; students comment/reply.
/// Pinned posts (pinnedAt set) sort above unpinned, newest pin first.
model ClassPost {
  id        String    @id @default(cuid())
  classId   String
  authorId  String
  title     String
  body      String
  tags      String[]  @default([])
  pinnedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  class       Class                 @relation(fields: [classId], references: [id], onDelete: Cascade)
  author      User                  @relation("ClassPostAuthor", fields: [authorId], references: [id])
  comments    ClassPostComment[]
  attachments ClassPostAttachment[]

  @@index([classId, pinnedAt, createdAt])
}

model ClassPostAttachment {
  id           String   @id @default(cuid())
  postId       String
  filename     String
  blobPath     String
  blobUrl      String
  mimeType     String
  sizeBytes    Int?
  /// INFO | EXERCISE â€” same baskets as class files / lesson attachments.
  materialKind String   @default("INFO")
  createdAt    DateTime @default(now())

  post ClassPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model ClassPostComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  body      String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post    ClassPost         @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User              @relation("ClassPostCommentAuthor", fields: [authorId], references: [id])
  parent  ClassPostComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies ClassPostComment[] @relation("CommentReplies")

  @@index([postId, createdAt])
  @@index([parentId])
}

/// One-time password reset tokens (store hash only; raw token goes in email/link).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

/// Reusable tags within one classroom (for filter/search).
model ClassTag {
  id        String   @id @default(cuid())
  classId   String
  name      String
  createdAt DateTime @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, name])
  @@index([classId])
}

/// One Lesson = one teaching session writeup in a classroom (NOT the classroom itself).
model ClassLesson {
  id          String   @id @default(cuid())
  classId     String
  /// Session/calendar day (UTC midnight).
  day         DateTime
  title       String?
  summary     String?
  tags        String[] @default([])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  class       Class                    @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdBy   User                     @relation("ClassLessonAuthor", fields: [createdById], references: [id])
  subEntries  ClassLessonSubEntry[]
  attachments ClassLessonAttachment[]

  @@unique([classId, day])
  @@index([classId, day])
}

model ClassLessonSubEntry {
  id        String   @id @default(cuid())
  lessonId  String
  kind      String   @default("NOTE") // TOPIC | NOTE | FILE | HOMEWORK | OTHER
  title     String
  body      String?
  tags      String[] @default([])
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  lesson ClassLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, sortOrder])
}

model ClassLessonAttachment {
  id           String   @id @default(cuid())
  lessonId     String
  filename     String
  blobPath     String
  blobUrl      String
  mimeType     String
  sizeBytes    Int?
  resourceId   String?
  /// INFO | EXERCISE â€” same baskets as class files / feed attachments.
  materialKind String   @default("INFO")
  createdAt    DateTime @default(now())

  lesson ClassLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}

/// Student target vocabulary from PDF read-mode tap-translate.
model VocabEntry {
  id              String   @id @default(cuid())
  studentId       String
  word            String
  normalizedWord  String
  translation     String?
  targetLang      String
  lookupCount     Int      @default(1)
  lastLookupAt    DateTime @default(now())
  /// 1-based rank in scripts/words-all-5000.json; null if outside the list.
  frequencyRank   Int?
  sourceResourceId String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, normalizedWord, targetLang])
  @@index([studentId, lastLookupAt])
  @@index([studentId, frequencyRank])
  @@index([studentId, lookupCount])
}

/// In-progress PDF write answers (AcroForm fields + overlay text boxes).
model PdfWriteDraft {
  id         String   @id @default(cuid())
  studentId  String
  resourceId String
  /// { fields: Record<string,string>, overlays: OverlayBox[] }
  data       Json     @default("{}")
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, resourceId])
  @@index([resourceId])
}

/// Student PDF worksheet submitted for teacher review (homework-style).
model PdfSubmission {
  id           String             @id @default(cuid())
  studentId    String
  resourceId   String
  classId      String?
  title        String
  /// Snapshot of draft data at submit time.
  data         Json
  status       PdfSubmissionStatus @default(SUBMITTED)
  teacherNote  String?
  submittedAt  DateTime           @default(now())
  reviewedAt   DateTime?
  reviewedById String?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  student    User  @relation("PdfSubmissionStudent", fields: [studentId], references: [id], onDelete: Cascade)
  reviewedBy User? @relation("PdfSubmissionReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)

  @@index([classId, submittedAt])
  @@index([studentId, submittedAt])
  @@index([resourceId, submittedAt])
}

/// Guided Story Writer
enum StoryAttemptStatus {
  PLANNING
  AWAITING_PLAN_APPROVAL
  DRAFTING
  REVISING
  SUBMITTED
  REVIEWED
}

enum StoryPlanApproval {
  NOT_REQUIRED
  PENDING
  APPROVED
  CHANGES_REQUESTED
}

enum StorySectionKind {
  BEGINNING
  MIDDLE
  CLIMAX
  ENDING
}

enum StoryIntegrityKind {
  PASTE_ATTEMPT
  PASTE_BLOCKED
  STEP_ENTERED
  AUTOSAVE
  SUBMIT
  GUIDE_BLOCKED
}

model StoryAssignment {
  id            String   @id @default(cuid())
  homeworkId    String?  @unique
  classId       String?
  studentId     String?
  createdById   String
  title         String
  instructions  String
  dueAt         DateTime?
  wordTarget    Int      @default(300)
  wordMin       Int?
  wordMax       Int?
  cefrLevel     String?
  requireCharacter     Boolean @default(true)
  requireSetting       Boolean @default(true)
  requireGoal          Boolean @default(true)
  requireProblem       Boolean @default(true)
  requireChain         Boolean @default(true)
  requireComplication  Boolean @default(true)
  requireClimax        Boolean @default(true)
  requireResolution    Boolean @default(true)
  grammarFocus  String[] @default([])
  vocabList     String[] @default([])
  vocabMinCount Int?
  vocabRequireAll Boolean @default(false)
  planningRequired            Boolean @default(true)
  storyMapRequired            Boolean @default(true)
  cannotDraftUntilPlanComplete Boolean @default(true)
  teacherMustApprovePlan      Boolean @default(false)
  revisionRequired            Boolean @default(true)
  restrictLargePaste          Boolean @default(true)
  trackProcess                Boolean @default(true)
  logicGrammarChecking        Boolean @default(true)
  pasteWordThreshold          Int     @default(25)
  isFreePractice              Boolean @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  homework  Homework? @relation(fields: [homeworkId], references: [id], onDelete: Cascade)
  class     Class?    @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdBy User      @relation("StoryAssignmentCreator", fields: [createdById], references: [id])
  attempts  StoryAttempt[]

  @@index([classId, createdAt])
  @@index([createdById, createdAt])
  @@index([isFreePractice, createdAt])
}

model StoryAttempt {
  id              String              @id @default(cuid())
  assignmentId    String
  studentId       String
  status          StoryAttemptStatus  @default(PLANNING)
  planApproval    StoryPlanApproval   @default(NOT_REQUIRED)
  currentStep     String              @default("ASSIGNMENT")
  studentTitle    String?
  studentTopic    String?
  submittedAt     DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  assignment StoryAssignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student    User            @relation("StoryAttemptStudent", fields: [studentId], references: [id], onDelete: Cascade)
  plan       StoryPlan?
  sections   StoryDraftSection[]
  revisions  StoryRevision[]
  integrity  StoryIntegrityEvent[]
  feedback   StoryTeacherFeedback?

  @@unique([assignmentId, studentId])
  @@index([studentId, status, updatedAt])
  @@index([status, submittedAt])
}

model StoryPlan {
  id               String    @id @default(cuid())
  attemptId        String    @unique
  characterName    String?
  characterTraits  String?
  characterWant    String?
  settingPlace     String?
  settingTime      String?
  settingMood      String?
  goalType         String?
  goalText         String?
  problemType      String?
  problemText      String?
  complicationText String?
  climaxIdea       String?
  resolutionText   String?
  mapSnapshot      Json?
  planComplete     Boolean   @default(false)
  completedAt      DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  attempt StoryAttempt     @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  events  StoryPlanEvent[]
}

model StoryPlanEvent {
  id        String   @id @default(cuid())
  planId    String
  sortOrder Int      @default(0)
  label     String
  cause     String?
  effect    String?
  notes     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  plan StoryPlan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId, sortOrder])
}

model StoryDraftSection {
  id        String           @id @default(cuid())
  attemptId String
  kind      StorySectionKind
  body      String           @default("")
  wordCount Int              @default(0)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  attempt StoryAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@unique([attemptId, kind])
  @@index([attemptId])
}

model StoryRevision {
  id           String    @id @default(cuid())
  attemptId    String
  passKind     String
  issues       Json      @default("[]")
  studentNotes String?
  completed    Boolean   @default(false)
  completedAt  DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  attempt StoryAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId, passKind])
}

model StoryIntegrityEvent {
  id        String             @id @default(cuid())
  attemptId String
  kind      StoryIntegrityKind
  meta      Json               @default("{}")
  createdAt DateTime           @default(now())

  attempt StoryAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)

  @@index([attemptId, createdAt])
}

model StoryTeacherFeedback {
  id          String   @id @default(cuid())
  attemptId   String   @unique
  body        String
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  attempt   StoryAttempt @relation(fields: [attemptId], references: [id], onDelete: Cascade)
  createdBy User         @relation("StoryFeedbackAuthor", fields: [createdById], references: [id])
}

/// Class money balance (teacher awards only â€” no student appeals).
model ClassWallet {
  id        String   @id @default(cuid())
  studentId String   @unique
  balance   Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  student User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  ledger  MoneyLedger[]
}

model MoneyLedger {
  id          String   @id @default(cuid())
  walletId    String
  amount      Int
  reason      String
  awardedById String
  createdAt   DateTime @default(now())

  wallet    ClassWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  awardedBy User        @relation("MoneyAwardAuthor", fields: [awardedById], references: [id])

  @@index([walletId, createdAt])
  @@index([awardedById, createdAt])
}

/// Generative daily vocab practice (separate from Guided Story Writer).
model VocabPracticePack {
  id            String    @id @default(cuid())
  studentId     String
  title         String
  story         String
  vocabUsed     String[]  @default([])
  /// { comprehension: [...], vocabActivities: [...] }
  activities    Json      @default("{}")
  /// Student answers / completion state
  answers       Json      @default("{}")
  provider      String?
  completedAt   DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, createdAt])
}

/// Teacher 1:1 lesson capture â€” screen frames, AI summary, notes + worksheets.
enum LessonCaptureStatus {
  ACTIVE
  PROCESSING
  COMPLETE
  ENDED
  FAILED
}

model LessonCaptureSession {
  id              String              @id @default(cuid())
  studentId       String
  teacherId       String
  startedAt       DateTime            @default(now())
  endedAt         DateTime?
  notes           String?
  topicsCovered   String[]            @default([])
  /// Visual content transcript (frames deleted after processing).
  transcript      String?
  summary         String?
  autoNotes       String?
  timeline        Json?
  framesCaptured  Int                 @default(0)
  processingError String?
  status          LessonCaptureStatus @default(ACTIVE)
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  student     User                      @relation("LessonCaptureStudent", fields: [studentId], references: [id], onDelete: Cascade)
  teacher     User                      @relation("LessonCaptureTeacher", fields: [teacherId], references: [id], onDelete: Cascade)
  liveNotes   LessonCaptureNote[]
  attachments LessonCaptureAttachment[]
  frames      LessonCaptureFrame[]
  audioChunks LessonCaptureAudioChunk[]

  @@index([teacherId, status])
  @@index([teacherId, startedAt])
  @@index([studentId, startedAt])
}

model LessonCaptureFrame {
  id         String   @id @default(cuid())
  sessionId  String
  frameIndex Int
  blobPath   String
  blobUrl    String
  mimeType   String   @default("image/webp")
  sizeBytes  Int?
  capturedAt DateTime @default(now())

  session LessonCaptureSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, frameIndex])
  @@index([sessionId, frameIndex])
}

/// Deferred â€” voice recording not in MVP.
model LessonCaptureAudioChunk {
  id              String   @id @default(cuid())
  sessionId       String
  chunkIndex      Int
  blobPath        String
  blobUrl         String
  mimeType        String
  sizeBytes       Int?
  transcribedText String?
  createdAt       DateTime @default(now())

  session LessonCaptureSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@unique([sessionId, chunkIndex])
  @@index([sessionId])
}

model LessonCaptureNote {
  id        String   @id @default(cuid())
  sessionId String
  body      String
  createdAt DateTime @default(now())

  session LessonCaptureSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId, createdAt])
}

model LessonCaptureAttachment {
  id        String   @id @default(cuid())
  sessionId String
  filename  String
  blobPath  String
  blobUrl   String
  mimeType  String
  sizeBytes Int?
  createdAt DateTime @default(now())

  session LessonCaptureSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)

  @@index([sessionId])
}

/// Japanese learning block progress (five-round engine per block).
model JapaneseBlockProgress {
  id              String   @id @default(cuid())
  userId          String
  blockNumber     Int      @default(1)
  /// round1 | round2 | round3 | round4 | round5
  phase           String   @default("round1")
  introIndex      Int      @default(0)
  inMini          Boolean  @default(false)
  miniIndex       Int      @default(0)
  /// Word indices for mini-review queue
  miniQueue       Json     @default("[]")
  qIndex          Int      @default(0)
  score           Int      @default(0)
  /// Shuffled word indices for formal rounds 2–5
  order           Json     @default("[]")
  /// Word indices missed in current round
  missed          Json     @default("[]")
  /// True when the learner chose "Retry this round" (skips known words in queue)
  roundIsRetry    Boolean  @default(false)
  /// { "2": 85, "3": 90, ... } round completion scores (%)
  roundScores     Json     @default("{}")
  bestRound5Score Int      @default(0)
  blockMastered   Boolean  @default(false)
  /// Block numbers the student may access (Block 1 always unlocked)
  unlockedBlocks  Int[]    @default([1])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, blockNumber])
  @@index([userId])
}

/// Per-user word customizations (mnemonic, pronunciation cue, TTS input).
model JapaneseWordOverride {
  id               String   @id @default(cuid())
  userId           String
  blockNumber      Int
  wordIndex        Int
  mnemonic         String?
  pronunciationCue String?
  ttsInput         String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, blockNumber, wordIndex])
  @@index([userId, blockNumber])
}

/// Per-word learning stats for a user within a block.
model JapaneseWordStat {
  id           String    @id @default(cuid())
  userId       String
  blockNumber  Int
  wordIndex    Int
  timesSeen            Int       @default(0)
  timesCorrect         Int       @default(0)
  timesMissed          Int       @default(0)
  consecutiveCorrect   Int       @default(0)
  known                Boolean   @default(false)
  missedEarlyRounds    Boolean   @default(false)
  round4CorrectCount   Int       @default(0)
  round5CorrectCount   Int       @default(0)
  lastSeenAt           DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, blockNumber, wordIndex])
  @@index([userId, blockNumber])
}

/// Cached LLM-generated story for a Japanese milestone gate (every 2 blocks).
model JapaneseMilestoneStory {
  id                String   @id @default(cuid())
  userId            String
  /// Milestone 1 = after blocks 1–2, milestone 2 = after blocks 3–4, etc.
  milestoneNumber   Int
  title             String
  /// Romaji-only paragraphs shown in the UI
  paragraphs        Json     @default("[]")
  /// Japanese/kana paragraphs for TTS playback
  ttsParagraphs     Json     @default("[]")
  /// True when story uses vocab-only simple patterns (invalidates old cached stories)
  vocabOnly         Boolean  @default(false)
  /// [{ id, prompt, answer }] — typed English comprehension
  comprehensionQs   Json     @default("[]")
  /// [{ id, promptEnglish, targetRomaji, targetEnglish, blockNumber, wordIndex }]
  productionQs      Json     @default("[]")
  vocabUsed         Json     @default("[]")
  provider          String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, milestoneNumber])
  @@index([userId])
}

/// Pass/fail progress for Japanese milestone story gates.
model JapaneseMilestoneProgress {
  id                 String    @id @default(cuid())
  userId             String
  milestoneNumber    Int
  passed             Boolean   @default(false)
  comprehensionScore Int?
  productionScore    Int?
  combinedScore      Int?
  attempts           Int       @default(0)
  passedAt           DateTime?
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, milestoneNumber])
  @@index([userId])
}

/// Per-user grammar block progress (3-phase model).
model GrammarBlockProgress {
  id                  String   @id @default(cuid())
  userId              String
  blockId             String
  sessionState        Json     @default("{}")
  teachCompleted      Boolean  @default(false)
  guidedCompleted     Boolean  @default(false)
  recallJtoECompleted Boolean  @default(false)
  recallEtoJCompleted Boolean  @default(false)
  mastered            Boolean  @default(false)
  unlockedBlocks      String[] @default([])
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, blockId])
  @@index([userId])
}
