generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TEACHER
  STUDENT
}

enum MembershipStatus {
  ACTIVE
  LEFT
  ARCHIVED
}

enum HomeworkStatus {
  ASSIGNED
  SUBMITTED
  REVIEWED
}

enum GoalStatus {
  ACTIVE
  ACHIEVED
  PAUSED
}

enum DiaryVisibility {
  SHARED
  PRIVATE
}

enum RecommendationApproval {
  DRAFT
  APPROVED
  REJECTED
}

enum RecommendationType {
  LINK
  TOOL
  ACTIVITY
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  role         Role
  archivedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  profile              StudentProfile?
  taughtClasses        Class[]              @relation("ClassTeacher")
  memberships          ClassMembership[]
  uploadedResources    Resource[]           @relation("ResourceUploader")
  createdLessons       Lesson[]             @relation("LessonCreator")
  createdHomework      Homework[]           @relation("HomeworkCreator")
  studentHomework      Homework[]           @relation("HomeworkStudent")
  individualLessons    Lesson[]             @relation("LessonStudent")
  individualResources  Resource[]           @relation("ResourceStudent")
  goals                Goal[]
  diaryEntries         DiaryEntry[]
  teacherNotesAuthored TeacherNote[]        @relation("NoteAuthor")
  teacherNotesAbout    TeacherNote[]        @relation("NoteStudent")
  recommendations      Recommendation[]     @relation("RecommendationStudent")
  progressEvents       LearningProgress[]
  classPostsAuthored   ClassPost[]          @relation("ClassPostAuthor")
  classPostComments    ClassPostComment[]   @relation("ClassPostCommentAuthor")
  passwordResetTokens  PasswordResetToken[]
  classDiaryAuthored   ClassLesson[]        @relation("ClassLessonAuthor")
}

model StudentProfile {
  id                 String   @id @default(cuid())
  userId             String   @unique
  fullName           String?
  preferredName      String?
  avatarId           String   @default("fox")
  englishLevel       String?
  firstLanguage      String?
  courseType         String?
  learningObjectives String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Class {
  id          String    @id @default(cuid())
  name        String
  description String?
  level       String?
  /// Short shareable join code (e.g. K7M2PQ). Unique across classrooms.
  inviteCode  String    @unique
  teacherId   String
  archivedAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  teacher         User               @relation("ClassTeacher", fields: [teacherId], references: [id])
  memberships     ClassMembership[]
  lessons         Lesson[]
  resources       Resource[]
  homework        Homework[]
  recommendations Recommendation[]
  posts           ClassPost[]
  classLessons    ClassLesson[]
  classTags       ClassTag[]

  @@index([teacherId, archivedAt])
}

/// Live membership policy: ACTIVE membership grants current class library access.
/// Leaving (LEFT/ARCHIVED) removes class-scoped access immediately.
/// Individual (studentId) assignments persist regardless of class membership.
model ClassMembership {
  id        String           @id @default(cuid())
  classId   String
  studentId String
  status    MembershipStatus @default(ACTIVE)
  joinedAt  DateTime         @default(now())
  leftAt    DateTime?

  class   Class @relation(fields: [classId], references: [id], onDelete: Cascade)
  student User  @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([classId, studentId])
  @@index([studentId, status])
}

model Lesson {
  id           String   @id @default(cuid())
  title        String
  date         DateTime @default(now())
  summary      String?
  teacherNotes String?
  tags         String[] @default([])
  topics       String[] @default([])
  classId      String?
  studentId    String?
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  class           Class?            @relation(fields: [classId], references: [id], onDelete: Cascade)
  student         User?             @relation("LessonStudent", fields: [studentId], references: [id], onDelete: Cascade)
  createdBy       User              @relation("LessonCreator", fields: [createdById], references: [id])
  resources       Resource[]
  homework        Homework[]
  recommendations Recommendation[]

  @@index([classId, date])
  @@index([studentId, date])
}

model Resource {
  id          String   @id @default(cuid())
  title       String
  filename    String
  blobPath    String
  blobUrl     String
  mimeType    String
  category    String?
  description String?
  sizeBytes   Int?
  tags        String[] @default([])
  lessonId    String?
  classId     String?
  studentId   String?
  uploadedById String
  createdAt   DateTime @default(now())

  lesson     Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  class      Class?  @relation(fields: [classId], references: [id], onDelete: Cascade)
  student    User?   @relation("ResourceStudent", fields: [studentId], references: [id], onDelete: Cascade)
  uploadedBy User    @relation("ResourceUploader", fields: [uploadedById], references: [id])

  @@index([classId, createdAt])
  @@index([studentId, createdAt])
  @@index([lessonId])
}

model Homework {
  id           String         @id @default(cuid())
  title        String
  instructions String
  dueAt        DateTime?
  status       HomeworkStatus @default(ASSIGNED)
  lessonId     String?
  classId      String?
  studentId    String?
  createdById  String
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt

  lesson    Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)
  class     Class?  @relation(fields: [classId], references: [id], onDelete: Cascade)
  student   User?   @relation("HomeworkStudent", fields: [studentId], references: [id], onDelete: Cascade)
  createdBy User    @relation("HomeworkCreator", fields: [createdById], references: [id])

  @@index([classId, dueAt])
  @@index([studentId, dueAt])
}

model Goal {
  id            String     @id @default(cuid())
  studentId     String
  title         String
  description   String?
  targetDate    DateTime?
  status        GoalStatus @default(ACTIVE)
  progressPct   Int        @default(0)
  teacherNotes  String?
  studentNotes  String?
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  student         User                 @relation(fields: [studentId], references: [id], onDelete: Cascade)
  checklistItems  GoalChecklistItem[]

  @@index([studentId, status])
}

/// Checklist steps on a student goal. Only teachers/admins can mark items done (accountability).
model GoalChecklistItem {
  id        String    @id @default(cuid())
  goalId    String
  title     String
  sortOrder Int       @default(0)
  done      Boolean   @default(false)
  doneAt    DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  goal Goal @relation(fields: [goalId], references: [id], onDelete: Cascade)

  @@index([goalId, sortOrder])
}

model DiaryEntry {
  id         String          @id @default(cuid())
  studentId  String
  date       DateTime        @default(now())
  title      String?
  body       String
  confidence Int?
  tag        String?
  visibility DiaryVisibility @default(SHARED)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  student User @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@index([studentId, date])
}

model TeacherNote {
  id               String   @id @default(cuid())
  studentId        String
  body             String
  visibleToStudent Boolean  @default(false)
  createdById      String
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  student   User @relation("NoteStudent", fields: [studentId], references: [id], onDelete: Cascade)
  createdBy User @relation("NoteAuthor", fields: [createdById], references: [id])

  @@index([studentId])
}

model Recommendation {
  id          String                 @id @default(cuid())
  title       String
  url         String?
  description String?
  type        RecommendationType     @default(LINK)
  topic       String?
  difficulty  String?
  approval    RecommendationApproval @default(DRAFT)
  classId     String?
  studentId   String?
  lessonId    String?
  createdAt   DateTime               @default(now())
  updatedAt   DateTime               @updatedAt

  class   Class?  @relation(fields: [classId], references: [id], onDelete: Cascade)
  student User?   @relation("RecommendationStudent", fields: [studentId], references: [id], onDelete: Cascade)
  lesson  Lesson? @relation(fields: [lessonId], references: [id], onDelete: SetNull)

  @@index([classId, approval])
  @@index([studentId, approval])
}

/// Portal learning progress persisted in DB (not localStorage).
model LearningProgress {
  id        String   @id @default(cuid())
  userId    String
  kind      String
  refId     String?
  data      Json     @default("{}")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, kind, refId])
  @@index([userId, kind])
}

/// Classroom bulletin: teachers/admins post; students comment/reply.
/// Pinned posts (pinnedAt set) sort above unpinned, newest pin first.
model ClassPost {
  id        String    @id @default(cuid())
  classId   String
  authorId  String
  title     String
  body      String
  tags      String[]  @default([])
  pinnedAt  DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  class       Class                 @relation(fields: [classId], references: [id], onDelete: Cascade)
  author      User                  @relation("ClassPostAuthor", fields: [authorId], references: [id])
  comments    ClassPostComment[]
  attachments ClassPostAttachment[]

  @@index([classId, pinnedAt, createdAt])
}

model ClassPostAttachment {
  id        String   @id @default(cuid())
  postId    String
  filename  String
  blobPath  String
  blobUrl   String
  mimeType  String
  sizeBytes Int?
  createdAt DateTime @default(now())

  post ClassPost @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@index([postId])
}

model ClassPostComment {
  id        String   @id @default(cuid())
  postId    String
  authorId  String
  body      String
  parentId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  post    ClassPost         @relation(fields: [postId], references: [id], onDelete: Cascade)
  author  User              @relation("ClassPostCommentAuthor", fields: [authorId], references: [id])
  parent  ClassPostComment? @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies ClassPostComment[] @relation("CommentReplies")

  @@index([postId, createdAt])
  @@index([parentId])
}

/// One-time password reset tokens (store hash only; raw token goes in email/link).
model PasswordResetToken {
  id        String    @id @default(cuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
}

/// Reusable tags within one classroom (for filter/search).
model ClassTag {
  id        String   @id @default(cuid())
  classId   String
  name      String
  createdAt DateTime @default(now())

  class Class @relation(fields: [classId], references: [id], onDelete: Cascade)

  @@unique([classId, name])
  @@index([classId])
}

/// One Lesson = one teaching session writeup in a classroom (NOT the classroom itself).
model ClassLesson {
  id          String   @id @default(cuid())
  classId     String
  /// Session/calendar day (UTC midnight).
  day         DateTime
  title       String?
  summary     String?
  tags        String[] @default([])
  createdById String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  class       Class                    @relation(fields: [classId], references: [id], onDelete: Cascade)
  createdBy   User                     @relation("ClassLessonAuthor", fields: [createdById], references: [id])
  subEntries  ClassLessonSubEntry[]
  attachments ClassLessonAttachment[]

  @@unique([classId, day])
  @@index([classId, day])
}

model ClassLessonSubEntry {
  id        String   @id @default(cuid())
  lessonId  String
  kind      String   @default("NOTE") // TOPIC | NOTE | FILE | HOMEWORK | OTHER
  title     String
  body      String?
  tags      String[] @default([])
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())

  lesson ClassLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId, sortOrder])
}

model ClassLessonAttachment {
  id         String   @id @default(cuid())
  lessonId   String
  filename   String
  blobPath   String
  blobUrl    String
  mimeType   String
  sizeBytes  Int?
  resourceId String?
  createdAt  DateTime @default(now())

  lesson ClassLesson @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@index([lessonId])
}
